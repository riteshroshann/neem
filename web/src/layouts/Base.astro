---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  /** The night sky behind the whole page, foot included. */
  night?: boolean;
}

const { title, description, path = "/", night } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const fullTitle = title === "Neem" ? "Neem: heat twins for Delhi schoolyards" : `${title} · Neem`;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ritesh Roshan" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The air reached 42 °C. The schoolyard felt like 47. 766 Delhi schoolyards, modelled for heat. Beside it, the Earth drawn in square cells and coloured by the height of the sun at 1 pm in Delhi, under a neem branch." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#13100d" />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class={night ? "night" : undefined}>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="masthead night">
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="Neem, home">Neem</a>
        <nav aria-label="Primary">
          <a href="/story">Story</a>
          <a href="/method">Method</a>
          <a href="/docs">Docs</a>
        </nav>
        <p class="credit">Created by <a href="https://github.com/riteshroshann">Ritesh&nbsp;Roshan</a></p>
      </div>
    </header>
    <div class="canopy" aria-hidden="true">
      <img src="/art/neem-left.svg" alt="" width="84" height="52" fetchpriority="low" />
      <img src="/art/neem-right.svg" alt="" width="84" height="52" fetchpriority="low" />
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class:list={["footer", night && "night"]}>
      <img class="ground" src={night ? "/art/ground-night.svg" : "/art/ground.svg"} alt="" width="320" height="44" loading="lazy" aria-hidden="true" />
      <div class="night foot-band">
        <div class="wrap foot">
          <p class="foot-name">
            <span class="wordmark">Neem</span>
            <span>Created by Ritesh&nbsp;Roshan for the WeMakeDevs × AWS Environmental Hacks, October 2026.</span>
          </p>
          <p class="small muted">
            Radiant heat by SOLWEIG on open data: Overture buildings, Meta and WRI canopy height,
            Copernicus elevation, OpenStreetMap schools and ERA5 weather.
          </p>
          <p class="small">
            <a href="https://github.com/riteshroshann/neem">Source on GitHub</a> · GPL-3.0 ·
            Engineered by Ritesh&nbsp;Roshan
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: var(--s-3);
    left: var(--s-3);
    width: auto;
    height: auto;
    clip: auto;
    padding: var(--s-2) var(--s-3);
    background: var(--ink);
    color: var(--paper);
    z-index: 10;
  }

  .masthead {
    position: sticky;
    top: 0;
    z-index: 5;
    background: rgb(19 16 13 / 0.92);
    backdrop-filter: saturate(1.3) blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .credit {
    margin: 0;
    font-size: var(--t-xs);
    color: var(--muted);
    white-space: nowrap;
  }

  .credit a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }

  .credit a:hover {
    text-decoration: underline;
  }

  /* neem branches hanging into the window's top corners, where the creepers begin; the first
     section leaves them room */
  .canopy {
    position: absolute;
    top: 57px;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 1;
  }

  /* each limb sways from where it leaves the masthead, so its base never lifts off that edge */
  .canopy img {
    width: clamp(150px, 25vw, 380px);
    height: auto;
    transform-origin: 5% 0;
    animation: sway 9s ease-in-out infinite alternate;
  }

  .canopy img + img {
    transform-origin: 95% 0;
    animation-delay: -4.5s;
  }

  :global(body:has(.planner-wrap)) .canopy img {
    width: clamp(110px, 13vw, 200px);
  }

  @keyframes sway {
    from {
      transform: rotate(-0.6deg);
    }
    to {
      transform: rotate(0.6deg);
    }
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-6);
    min-height: 56px;
  }

  .wordmark {
    font: 400 1.75rem / 1 var(--serif);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: var(--s-5);
    font-size: var(--t-s);
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  /* padding, not margin, so a night page's sky runs down to the ground */
  .footer {
    padding-top: var(--s-8);
  }

  /* the strip keeps its own proportions (320 x 44 cells) on wide screens, so nothing is cut;
     on phones it keeps a readable height and crops the sides instead */
  .ground {
    display: block;
    width: 100%;
    height: max(110px, calc(100vw * 44 / 320));
    object-fit: cover;
    object-position: 50% 100%;
    margin-bottom: -1px;
  }

  .foot-band {
    padding-block: var(--s-7) var(--s-8);
  }

  .foot {
    display: grid;
    gap: var(--s-3);
    max-width: var(--page);
  }

  .foot-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    font-size: var(--t-l);
    margin-bottom: var(--s-2);
  }

  .foot p:first-child {
    max-width: var(--measure);
  }

  /* phones: the header scrolls away, and the credit gets its own line under the links */
  @media (max-width: 560px) {
    .masthead {
      position: static;
    }
    .bar {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "word nav"
        "credit credit";
      row-gap: 0;
      padding-block: var(--s-2) var(--s-3);
    }
    .wordmark {
      grid-area: word;
    }
    nav {
      grid-area: nav;
      gap: var(--s-4);
    }
    .credit {
      grid-area: credit;
    }
    .canopy {
      top: 70px;
    }
  }
</style>
