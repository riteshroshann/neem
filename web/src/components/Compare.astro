---
import showcase from "../data/showcase.json";
import { delta, lakh, longDate, ml, rupees, temp } from "../lib/format";
import HeatScale from "./HeatScale.astro";

const { plan, grid, school_id: id, name } = showcase;
const [yardToday, yardPlan] = plan.yard_1pm as [number, number];
const [riseToday, risePlan] = plan.child_rise as [number, number];
const [waterToday, waterPlan] = plan.water_ml as [number, number];
const waterSaved = Math.round(waterPlan - waterToday);
---

<section class="wrap section compare rule" id="plan" aria-labelledby="compare-title">
  <div class="compare-copy">
    <p class="kicker">Plant, preview, verify</p>
    <h2 class="title" id="compare-title">What {plan.trees} neem trees do</h2>
    <p class="muted compare-lede">
      A planning agent placed them inside a {lakh(plan.budget_rs)} budget. Then a full SOLWEIG run
      checked every square metre.
    </p>
    <dl class="facts num">
      <div>
        <dt class="label">Yard at 1&nbsp;pm</dt>
        <dd>{yardToday.toFixed(1)} <span class="glyph" aria-hidden="true">→</span><span class="visually-hidden">to</span> {temp(yardPlan)}</dd>
        <dd class="change">{delta(yardPlan - yardToday)}</dd>
      </div>
      <div>
        <dt class="label">Child's peak core rise</dt>
        <dd>{riseToday.toFixed(2)} <span class="glyph" aria-hidden="true">→</span><span class="visually-hidden">to</span> {temp(risePlan, 2)}</dd>
        <dd class="change">{delta(risePlan - riseToday, 2)}</dd>
      </div>
      <div>
        <dt class="label">Water lost over the morning</dt>
        <dd>{Math.round(waterToday)} <span class="glyph" aria-hidden="true">→</span><span class="visually-hidden">to</span> {ml(waterPlan)}</dd>
        <dd class="change">{waterSaved < 0 ? "\u2212" : "+"}{Math.abs(waterSaved)}&nbsp;ml</dd>
      </div>
      <div>
        <dt class="label">Cost, at {rupees(plan.cost_rs / plan.trees)} a tree</dt>
        <dd><span class="glyph">₹</span>{rupees(plan.cost_rs).slice(1)}</dd>
      </div>
    </dl>
    <a class="button" href={`/school/${id}`}>Open this school and plant your own</a>
  </div>

  <figure class="compare-figure">
    <div class="compare-stage" data-compare style={`--split: 50%; aspect-ratio: ${grid.cols} / ${grid.rows}`}>
      <img src={`/twins/${id}/map-1pm-plan.png`} alt={`${name} at 1 pm with ${plan.trees} neem trees: their shade cools the yard`} width={grid.cols} height={grid.rows} loading="lazy" decoding="async" />
      <img class="before" src={`/twins/${id}/map-1pm.png`} alt={`${name} at 1 pm today`} width={grid.cols} height={grid.rows} loading="lazy" decoding="async" />
      <span class="tag left num">Today · {temp(yardToday)}</span>
      <span class="tag right num">{plan.trees} neems · {temp(yardPlan)}</span>
      <span class="handle" aria-hidden="true"></span>
      <input type="range" min="0" max="100" value="50" step="1" data-trees={plan.trees} aria-label="Slide between the yard today and with the trees" aria-valuetext="Half today, half with the trees" />
    </div>
    <figcaption>
      <HeatScale />
      <p class="xs muted">
        Feels-like temperature (UTCI) at 1&nbsp;pm, {longDate(showcase.day)}, one cell per square
        metre. Grey blocks are roofs; colour beyond the school wall is faded.
      </p>
    </figcaption>
  </figure>
</section>

<script>
  for (const stage of document.querySelectorAll<HTMLElement>("[data-compare]")) {
    const input = stage.querySelector("input");
    if (!input) continue;
    const trees = input.dataset.trees ?? "";
    const set = (v: number) => {
      stage.style.setProperty("--split", `${v}%`);
      const left = Math.round(v);
      input.setAttribute("aria-valuetext", `${left}% today, ${100 - left}% with ${trees} neems`);
    };
    input.addEventListener("input", () => set(Number(input.value)));
    // one slow sweep the first time it comes into view, so the slider explains itself
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    // the first touch, key or drag ends it for good; Safari never focuses a tapped range input,
    // so focus can't tell us. Events on the input bubble up to the stage.
    let stopped = false;
    for (const type of ["pointerdown", "keydown", "input"]) {
      stage.addEventListener(type, () => {
        stopped = true;
      });
    }
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        seen.disconnect();
        const t0 = performance.now();
        const step = (now: number) => {
          if (stopped) return;
          const t = Math.min(1, (now - t0) / 1800);
          const v = 50 + 28 * Math.sin(t * Math.PI) * (1 - t * 0.2);
          set(v);
          input.value = String(Math.round(v));
          if (t < 1) requestAnimationFrame(step);
          else set(Number(input.value));
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.6 },
    );
    seen.observe(stage);
  }
</script>

<style>
  .compare {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: var(--s-8);
    align-items: center;
  }

  .compare-copy {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .compare-lede {
    max-width: 44ch;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-6);
    margin: var(--s-4) 0 var(--s-5);
    width: 100%;
    max-width: 520px;
  }

  .facts dd {
    margin: var(--s-1) 0 0;
    font: 400 var(--t-xl) / 1.1 var(--serif);
    letter-spacing: -0.01em;
  }

  .facts dd.change {
    margin-top: 2px;
    font: 500 var(--t-xs) / 1.3 var(--sans);
    color: var(--neem);
  }

  /* Instrument Serif has no arrow or rupee sign: borrow them from Geist */
  .glyph {
    font-family: var(--sans);
    font-size: 0.8em;
  }

  .compare-figure {
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }

  .compare-stage {
    position: relative;
    border: 1px solid var(--ink);
    overflow: hidden;
    user-select: none;
  }

  .compare-stage:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* opaque paper behind each map: the clipped top image must hide the one beneath, or the
     faded neighbourhood draws twice on one side and looks hotter than it is */
  .compare-stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    background: var(--paper);
  }

  .before {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--ink);
    pointer-events: none;
  }

  .handle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34px;
    height: 34px;
    transform: translate(-50%, -50%);
    background: var(--paper);
    border: 1px solid var(--ink);
    /* a grip of three separate cells */
    background-image:
      linear-gradient(var(--ink), var(--ink)), linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink));
    background-size: 4px 4px;
    background-repeat: no-repeat;
    background-position:
      8px 50%,
      50% 50%,
      calc(100% - 8px) 50%;
  }

  /* above the handle, so the split line passes behind a label instead of through it */
  .tag {
    position: absolute;
    z-index: 1;
    top: var(--s-3);
    padding: 4px 8px;
    background: var(--paper);
    border: 1px solid var(--ink);
    font-size: var(--t-xs);
    font-weight: 500;
    pointer-events: none;
  }

  .tag.left {
    left: var(--s-3);
  }

  .tag.right {
    right: var(--s-3);
  }

  input[type="range"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  @media (max-width: 900px) {
    .compare {
      grid-template-columns: minmax(0, 1fr);
    }
    .compare-figure {
      width: min(100%, 520px);
      justify-self: center;
    }
  }
</style>
