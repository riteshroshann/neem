---
import Compare from "../components/Compare.astro";
import Globe from "../components/Globe.astro";
import Pipeline from "../components/Pipeline.astro";
import Ride from "../components/Ride.astro";
import Scales from "../components/Scales.astro";
import Seed from "../components/Seed.astro";
import Yard3D from "../components/Yard3D.astro";
import ranking from "../data/ranking.json";
import showcase from "../data/showcase.json";
import twins from "../data/twins.json";
import Base from "../layouts/Base.astro";
import { delhiMap } from "../lib/delhi";
import { longDate, pct, schoolName, temp } from "../lib/format";
import { heatHex } from "../lib/palette";
import { CANOPY_QUARTERS, COOLEST, HOTTEST, YARDS_BY_HEAT, yardHex } from "../lib/yards";

const { stats, schools } = ranking;
const DTU = { lat: 28.7499, lon: 77.117 };

function km(lat: number, lon: number): number {
  const r = 6371;
  const dLat = ((lat - DTU.lat) * Math.PI) / 180;
  const dLon = ((lon - DTU.lon) * Math.PI) / 180;
  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos((DTU.lat * Math.PI) / 180) * Math.cos((lat * Math.PI) / 180) * Math.sin(dLon / 2) ** 2;
  return 2 * r * Math.asin(Math.sqrt(a));
}

const map = delhiMap(1000);
const { cell } = showcase;
const { bare, leafy } = CANOPY_QUARTERS;
const DEFAULT_ROWS = 20;
// the list shows schools OpenStreetMap names; unnamed ones still count in every figure and map
const listed = schools.filter((s) => schoolName(s.name) !== "Unnamed school");

// labels in HTML over the map stay readable on a phone; the leader lines scale with the SVG
const at = (x: number, y: number) =>
  `left:${((x / map.width) * 100).toFixed(2)}%;top:${((y / map.height) * 100).toFixed(2)}%`;
const callout = (lon: number, lat: number) => {
  const x = map.x(lon);
  const y = map.y(lat);
  const dx = x > map.width / 2 ? -46 : 46;
  const dy = y > map.height / 2 ? -46 : 46;
  return { x, y, ex: x + dx, ey: y + dy, side: dx < 0 ? "left" : "right" };
};
const extremes = [
  HOTTEST && { yard: HOTTEST, title: "Hottest yard", ...callout(HOTTEST.lon, HOTTEST.lat) },
  COOLEST && { yard: COOLEST, title: "Coolest yard", ...callout(COOLEST.lon, COOLEST.lat) },
].filter((e) => !!e);
const ramp = Array.from(
  { length: 24 },
  (_, i) => stats.utci_min + ((i + 0.5) / 24) * (stats.utci_max - stats.utci_min),
);
const medianAt = ((stats.utci_median - stats.utci_min) / (stats.utci_max - stats.utci_min)) * 100;
---

<Base
  title="Neem"
  description={`Neem maps how hot ${stats.schools} Delhi schoolyards feel to a child on a heatwave day, and lets planners test trees and shade, square metre by square metre, before they plant.`}
  night
>
  <section class="hero wrap page-head">
    <div class="hero-copy">
      <p class="kicker">{stats.schools} Delhi schoolyards, modelled for heat</p>
      <h1 class="display">
        <span>The air reached {Math.round(cell.ta)}&nbsp;°C.</span>
        <span>The schoolyard felt like&nbsp;<em style={`--cell:${heatHex(cell.utci)}`}>{Math.round(cell.utci)}.</em></span>
      </h1>
      <p class="lede">
        Neem maps the heat a child feels in {stats.schools} Delhi schoolyards, then works out,
        square metre by square metre, how many neem trees it takes to cool one down.
      </p>
      <div class="actions">
        <a class="button" href={`/school/${showcase.school_id}`}>Plant trees in a real school</a>
        <a class="button quiet" href="#map">See all {stats.schools} yards</a>
      </div>
      <p class="hero-links">
        <a href="#future">Ride thirty years forward <span aria-hidden="true">↓</span></a>
        <a href="/story">Read the story</a>
      </p>
      <p class="xs muted hero-note">
        {temp(cell.utci)} feels-like (UTCI) at 1&nbsp;pm on {longDate(showcase.day)}, at the centre
        of the open yard of {showcase.name}: a 1&nbsp;m SOLWEIG run. Air {temp(cell.ta)}, from ERA5.
      </p>
    </div>
    <Globe spin />
  </section>

  <Ride />
  <Seed />

  <section class="wrap figures rule">
    <div>
      <p class="figure num">{stats.schools}</p>
      <p class="small">
        schoolyards modelled at 2 m for 9 am, 11 am and 1 pm. {stats.failed_no_ground} more had no
        open ground to model.
      </p>
    </div>
    <div>
      <p class="figure num">{temp(bare.heat - leafy.heat)}</p>
      <p class="small">
        cooler in the leafiest quarter of yards ({pct(leafy.cover)} tree cover) than in the barest
        ({pct(bare.cover)}). Across all {stats.schools}, tree cover and heat correlate at
        r&nbsp;=&nbsp;{stats.canopy_heat_r.toFixed(2).replace("-", "−")}.
      </p>
    </div>
    <div>
      <p class="figure num">1 in {Math.round(1 / stats.share_quarter_extreme)}</p>
      <p class="small">
        yards spend more than a quarter of the school morning in extreme heat stress, a feels-like
        temperature above 46&nbsp;°C.
      </p>
    </div>
  </section>

  <Scales />
  <Compare />
  <Yard3D />
  <Pipeline />

  <section class="wrap section map-section rule" id="map">
    <div class="map-text">
      <h2 class="title">Where the yards run hottest</h2>
      <p class="muted">
        Each square is a school inside Delhi's boundary, coloured by the mean feels-like temperature
        over its open ground at 9&nbsp;am, 11&nbsp;am and 1&nbsp;pm. Outlined squares have a full
        1&nbsp;m heat twin you can open and redesign.
      </p>
      <div class="yard-scale" role="img" aria-label={`Colour scale from ${temp(stats.utci_min)}, the coolest yard, to ${temp(stats.utci_max)}, the hottest; the median yard is ${temp(stats.utci_median)}.`}>
        <div class="yard-cells">
          {ramp.map((v) => <i style={`background:${yardHex(v)}`}></i>)}
        </div>
        <div class="yard-ticks xs num" aria-hidden="true">
          <span style="left:0">{temp(stats.utci_min)}</span>
          <span style={`left:${medianAt.toFixed(1)}%`} class="mid">median {temp(stats.utci_median)}</span>
          <span style="left:100%" class="end">{temp(stats.utci_max)}</span>
        </div>
        <p class="xs muted">Colours span the city's range so small differences show.</p>
      </div>
    </div>
    <div class="map-stage">
    <svg
      class="dotmap"
      viewBox={`0 0 ${map.width} ${map.height}`}
      role="img"
      aria-label={`Map of ${stats.schools} Delhi schools coloured by yard heat`}
    >
      <path d={map.outline} fill="var(--wash)" stroke="var(--line)" stroke-width="1.5" />
      {YARDS_BY_HEAT.map((s) => (
        <rect x={(map.x(s.lon) - 4.5).toFixed(1)} y={(map.y(s.lat) - 4.5).toFixed(1)} width="9" height="9" fill={yardHex(s.utci_mean)}>
          <title>{`${s.name}: ${s.utci_mean.toFixed(1)} °C`}</title>
        </rect>
      ))}
      {extremes.map((e) => (
        <polyline points={`${e.x},${e.y} ${e.ex},${e.ey}`} class="lead"></polyline>
      ))}
      {twins.map((t) => (
        <a href={`/school/${t.school_id}`} aria-label={`Open the heat twin of ${schoolName(t.name)}`}>
          <rect x={(map.x(t.lon) - 24).toFixed(1)} y={(map.y(t.lat) - 24).toFixed(1)} width="48" height="48" fill="transparent" stroke="none"></rect>
          <rect x={(map.x(t.lon) - 12).toFixed(1)} y={(map.y(t.lat) - 12).toFixed(1)} width="24" height="24" fill="transparent" stroke="var(--ink)" stroke-width="2" class="ring"></rect>
        </a>
      ))}
      <rect x={(map.x(DTU.lon) - 3.5).toFixed(1)} y={(map.y(DTU.lat) - 3.5).toFixed(1)} width="7" height="7" fill="var(--ink)"></rect>
    </svg>
    {extremes.map((e) => (
      <p class="map-label xs num" data-side={e.side} style={at(e.ex, e.ey)}>
        <b>{e.title}</b> {temp(e.yard.utci_mean)} · {pct(e.yard.canopy_cover)} tree cover
      </p>
    ))}
    <p class="map-label dtu-label xs" data-side="right" style={at(map.x(DTU.lon) + 8, map.y(DTU.lat))}>DTU</p>
    </div>
  </section>

  <section class="wrap section twins rule" id="twins">
    <h2 class="title">Open a heat twin</h2>
    <p class="muted twins-intro">
      Four government schools near DTU, modelled at 1 m from 7 am to 1 pm. Plant neem, peepal,
      jamun or amaltas, or put up a shade sail, and see the yard change before anyone digs.
    </p>
    <ol class="twin-list">
      {twins.map((t) => (
        <li class="rule-light">
          <a href={`/school/${t.school_id}`} class="twin-row">
            <img src={`/thumbs/${t.school_id}.png`} alt="" width="96" height="96" loading="lazy" />
            <span class="twin-text">
              <span class="twin-name">{schoolName(t.name)}</span>
              <span class="twin-meta small muted num">
                {km(t.lat, t.lon).toFixed(1)}&nbsp;km from DTU · {temp(t.utci_mean)} yard average ·
                rank {t.rank} of {stats.schools}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section ranking rule" id="schoolyards">
    <div class="ranking-head">
      <h2 class="title">Every yard, hottest first</h2>
      <div class="filters">
        <label class="visually-hidden" for="q">Find a school</label>
        <input id="q" type="search" placeholder="Find a school, e.g. Rohini" autocomplete="off" aria-keyshortcuts="/" />
        <label class="check small"><input id="gov" type="checkbox" /> Government only</label>
      </div>
    </div>
    <p class="muted small">
      Yard heat is the mean feels-like temperature over open ground at 9&nbsp;am, 11&nbsp;am and
      1&nbsp;pm; extreme is the share of those yard-hours above 46&nbsp;°C.{" "}
      Schools without a name in OpenStreetMap are left out of this list but counted everywhere
      else.{" "}
      <span id="count" aria-live="polite">Showing the hottest {DEFAULT_ROWS}. Search to find any of the {listed.length}.</span>
    </p>
    <table class="table num">
      <thead>
        <tr>
          <th scope="col">City rank</th>
          <th scope="col"><span class="visually-hidden">Heat map</span></th>
          <th scope="col">School</th>
          <th scope="col" class="r">Yard heat</th>
          <th scope="col" class="r">Extreme</th>
          <th scope="col" class="r">Tree cover</th>
        </tr>
      </thead>
      <tbody id="rows">
        {listed.map((s, i) => (
          <tr
            data-name={schoolName(s.name).toLowerCase()}
            data-gov={s.government ? "1" : "0"}
            hidden={i >= DEFAULT_ROWS}
          >
            <td>{s.rank}</td>
            <td><img src={`/thumbs/${s.school_id}.png`} alt="" width="40" height="40" loading="lazy" /></td>
            <td>
              {s.has_twin ? (
                <a href={`/school/${s.school_id}`}>{schoolName(s.name)}</a>
              ) : (
                schoolName(s.name)
              )}
              {s.government && <span class="muted"> · Government</span>}
            </td>
            <td class="r">{temp(s.utci_mean)}</td>
            <td class="r">{pct(s.extreme_fraction)}</td>
            <td class="r">{pct(s.canopy_cover)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="small muted" id="empty" hidden>No school matches that search.</p>
    <button type="button" class="button quiet more" id="more">Show the hottest 100</button>
  </section>

  <script>
    const q = document.getElementById("q") as HTMLInputElement;
    const gov = document.getElementById("gov") as HTMLInputElement;
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#rows tr"));
    const empty = document.getElementById("empty") as HTMLElement;
    const count = document.getElementById("count") as HTMLElement;
    const more = document.getElementById("more") as HTMLButtonElement;
    let limit = 20;

    function filter() {
      const term = q.value.trim().toLowerCase();
      const searching = Boolean(term) || gov.checked;
      let shown = 0;
      for (const row of rows) {
        const match =
          (!term || (row.dataset.name ?? "").includes(term)) && (!gov.checked || row.dataset.gov === "1");
        const visible = match && (searching || shown < limit);
        row.hidden = !visible;
        if (visible) shown++;
      }
      empty.hidden = shown > 0;
      more.hidden = searching || limit >= 100;
      count.textContent = searching
        ? `${shown} ${shown === 1 ? "school matches" : "schools match"}.`
        : `Showing the hottest ${limit}. Search to find any of the ${rows.length}.`;
      // keep the search in the address, so a result can be shared
      const url = new URL(window.location.href);
      if (term) url.searchParams.set("q", term);
      else url.searchParams.delete("q");
      history.replaceState(null, "", url);
    }

    q.addEventListener("input", filter);
    gov.addEventListener("change", filter);
    more.addEventListener("click", () => {
      limit = 100;
      filter();
    });
    // "/" jumps to the search, as on most sites with one
    document.addEventListener("keydown", (e) => {
      const typing = e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement;
      if (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        q.focus();
      }
    });
    const initial = new URLSearchParams(window.location.search).get("q");
    if (initial) {
      q.value = initial;
      filter();
    }
  </script>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--s-8);
    align-items: center;
    padding-bottom: var(--s-9);
  }

  .hero-copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .hero .display {
    font-size: clamp(2.75rem, 5.4vw, 5.75rem);
  }

  .hero .display span {
    display: block;
    max-width: 11ch;
  }

  /* the feels-like number wears its own colour on the heat ramp, set inline from the run */
  .hero .display em {
    font-style: normal;
    background: var(--cell);
    color: #f7f1e7;
    padding: 0 0.1em 0.04em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    font-size: var(--t-s);
  }

  .hero-note {
    max-width: 52ch;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-7);
    padding-block: var(--s-6) var(--s-8);
  }

  .figures .figure {
    font-size: clamp(3rem, 6vw, 5rem);
    margin-bottom: var(--s-3);
  }

  .figures .small {
    max-width: 34ch;
  }

  .map-section {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: start;
  }

  .map-text {
    display: grid;
    gap: var(--s-4);
    position: sticky;
    top: 96px;
  }

  .yard-scale {
    display: grid;
    gap: var(--s-1);
  }

  .yard-cells {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    gap: 2px;
  }

  .yard-cells i {
    height: 10px;
  }

  .yard-ticks {
    position: relative;
    height: 18px;
  }

  .yard-ticks span {
    position: absolute;
    top: 2px;
    white-space: nowrap;
  }

  .yard-ticks .mid {
    transform: translateX(-50%);
    color: var(--muted);
  }

  .yard-ticks .end {
    transform: translateX(-100%);
  }

  .map-stage {
    position: relative;
  }

  .lead {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .map-label {
    position: absolute;
    transform: translateY(-50%);
    margin: 0;
    padding: 3px 7px;
    background: var(--paper);
    border: 1px solid var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }

  .map-label[data-side="left"] {
    transform: translate(-100%, -50%);
  }

  .map-label b {
    font-weight: 600;
  }

  .dtu-label {
    border: 0;
    background: none;
    padding: 0;
    font-weight: 600;
  }

  .dotmap {
    width: 100%;
    height: auto;
  }

  .dotmap a:hover .ring,
  .dotmap a:focus-visible .ring {
    stroke-width: 3.5;
  }


  .twins-intro {
    max-width: 52ch;
    margin: var(--s-4) 0 var(--s-6);
  }

  .twin-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .twin-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--s-5);
    align-items: center;
    padding-block: var(--s-4);
    text-decoration: none;
  }

  .twin-text {
    display: grid;
    gap: var(--s-2);
  }

  .twin-row:hover .twin-name {
    text-decoration: underline;
  }

  .twin-name {
    font: 400 var(--t-xl) / 1.1 var(--serif);
  }

  .ranking-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-bottom: var(--s-4);
  }

  .filters {
    display: flex;
    gap: var(--s-5);
    align-items: center;
  }

  .filters input[type="search"] {
    min-height: 44px;
    width: 260px;
    padding: 0 var(--s-3);
    border: 1px solid var(--ink);
    border-radius: 0;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
  }

  .check {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    cursor: pointer;
  }

  .check input {
    accent-color: var(--neem);
    width: 18px;
    height: 18px;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--s-5);
    font-size: var(--t-s);
  }

  /* the header stays under the masthead while the rows scroll; borders don't stick, shadows do */
  .table th {
    position: sticky;
    top: 57px;
    z-index: 1;
    text-align: left;
    font-weight: 500;
    font-size: var(--t-xs);
    color: var(--muted);
    background: var(--paper);
    box-shadow: inset 0 -1px 0 var(--ink);
    padding: var(--s-2) var(--s-3) var(--s-2) 0;
  }

  /* on phones the masthead scrolls away, so the header sticks to the very top */
  @media (max-width: 560px) {
    .table th {
      top: 0;
    }
  }

  .more {
    margin-top: var(--s-5);
  }

  .more[hidden] {
    display: none;
  }

  .table td {
    border-bottom: 1px solid var(--line);
    padding: var(--s-2) var(--s-3) var(--s-2) 0;
    vertical-align: middle;
  }

  .table .r {
    text-align: right;
    white-space: nowrap;
  }

  .table img {
    image-rendering: pixelated;
  }

  @media (max-width: 900px) {
    .hero,
    .map-section {
      grid-template-columns: 1fr;
    }
    /* phones see the Earth right under the headline, not a screen later */
    .hero {
      gap: var(--s-5);
    }
    .hero-copy {
      display: contents;
    }
    .hero .kicker,
    .hero .display {
      order: 1;
    }
    .hero :global(.globe) {
      order: 2;
      width: min(100%, 420px);
      justify-self: center;
    }
    .lede,
    .actions,
    .hero-links,
    .hero-note {
      order: 3;
    }
    .hero .display {
      font-size: clamp(2.75rem, 9vw, 4.5rem);
    }
    .map-text {
      position: static;
    }
    .twin-row {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: var(--s-4);
      align-items: start;
    }
    .twin-row img {
      width: 64px;
      height: 64px;
    }
    .twin-name {
      font-size: var(--t-l);
    }
    .table th:nth-child(2),
    .table td:nth-child(2),
    .table th:nth-child(6),
    .table td:nth-child(6) {
      display: none;
    }
    .filters input[type="search"] {
      width: 100%;
    }
    .filters {
      width: 100%;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 620px) {
    .figures {
      grid-template-columns: 1fr;
    }
  }
</style>
